APP_ENV=development
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./data/metadata.db
UPLOAD_DIR=./data/uploads
CACHE_DIR=./data/cache
MAX_UPLOAD_MB=100

# LLM (Step 3)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash

# Auth / sessions
# Long random string used to sign session cookies, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to start with APP_ENV=production while this is unset/default.
SECRET_KEY=
# Used to build password-reset links
FRONTEND_URL=http://localhost:3000
# APP_ENV=production also turns on the Secure flag for the dl_session cookie (serve over HTTPS)
